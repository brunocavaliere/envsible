{
  "name": "envsible",
  "version": "0.1.3",
  "description": "Local environment variable auditing for Vercel projects.",
  "type": "module",
  "files": ["dist"],
  "bin": {"envsible": "dist/cli/index.js"},
  "scripts": {
    "dev": "vite",
    "dev:cli": "tsx src/cli/index.ts dashboard --demo",
    "build": "tsc --noEmit && vite build && tsup src/cli/index.ts --format esm --out-dir dist/cli --clean false",
    "audit": "tsx src/cli/index.ts audit",
    "scan": "npm run build && tsx src/cli/index.ts scan",
    "dashboard": "npm run build && tsx src/cli/index.ts dashboard",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
